  instrument_id uuid not null references af_market.instruments(id) on delete cascade,
  valuation_date date not null,
  bucket_code text not null,
  residual_maturity_days integer not null,
  methodology_version_id uuid not null references af_method.methodology_versions(id),
  calculation_run_id uuid references af_ops.calculation_runs(id),
  created_at timestamptz not null default now(),
  unique(instrument_id, valuation_date, methodology_version_id)
);

create table if not exists af_calc.ranking_definitions (
  id uuid primary key default gen_random_uuid(),
  code text not null unique,
  name text not null,
  category_id uuid not null references af_ref.category_nodes(id),
  currency_id uuid not null references af_ref.currencies(id),
  period_code text not null,
  metric_code text not null,
  methodology_version_id uuid references af_method.methodology_versions(id),
  status text not null default 'ACTIVE',
  created_at timestamptz not null default now()
);

create table if not exists af_calc.ranking_results (
  id uuid primary key default gen_random_uuid(),
  ranking_definition_id uuid not null references af_calc.ranking_definitions(id) on delete cascade,
  ranking_date date not null,
  fund_id uuid not null references af_fund.funds(id) on delete cascade,
  share_class_id uuid references af_fund.share_classes(id) on delete cascade,
  metric_value numeric(24,16),
  rank integer,
  population_count integer,
  percentile numeric(12,8),
  quartile smallint,
  quality_score numeric(8,6),
  calculation_run_id uuid references af_ops.calculation_runs(id),
  created_at timestamptz not null default now(),
  unique(ranking_definition_id, ranking_date, fund_id, share_class_id)
);

create table if not exists af_quality.validation_rules (
  id uuid primary key default gen_random_uuid(),
  code text not null unique,
  name text not null,
  domain text not null,
  severity text not null default 'ERROR',
  rule_type text not null,
  parameters jsonb not null default '{}'::jsonb,
  is_active boolean not null default true,
  created_at timestamptz not null default now()
);

create table if not exists af_quality.validation_results (
  id uuid primary key default gen_random_uuid(),
  validation_rule_id uuid not null references af_quality.validation_rules(id),
  entity_type text not null,
  entity_id uuid,
  economic_date date,
  status text not null,
  observed_value jsonb,
  expected_value jsonb,
  message text,
  source_observation_id uuid references af_source.source_observations(id),
  pipeline_run_id uuid references af_ops.pipeline_runs(id),
  calculation_run_id uuid references af_ops.calculation_runs(id),
  created_at timestamptz not null default now()
);
create index if not exists idx_validation_results_entity on af_quality.validation_results(entity_type, entity_id, economic_date);

create table if not exists af_quality.data_quality_results (
  id uuid primary key default gen_random_uuid(),
  entity_type text not null,
  entity_id uuid not null,
  economic_date date,
  completeness_score numeric(8,6),
  freshness_score numeric(8,6),
  consistency_score numeric(8,6),
  provenance_score numeric(8,6),
  overall_score numeric(8,6),
  source_count integer not null default 0,
  conflict_count integer not null default 0,
  missing_field_count integer not null default 0,
  estimated_value_count integer not null default 0,
  correction_count integer not null default 0,
  details jsonb not null default '{}'::jsonb,
  calculation_run_id uuid references af_ops.calculation_runs(id),
  created_at timestamptz not null default now(),
  unique(entity_type, entity_id, economic_date)
);

create table if not exists af_publish.published_series (
  id uuid primary key default gen_random_uuid(),
  series_code text not null unique,
  series_name text not null,
  series_type text not null,
  index_definition_id uuid references af_calc.index_definitions(id),
  official_index_id uuid references af_market.official_indices(id),
  rate_series_id uuid references af_market.official_rate_series(id),
  category_id uuid references af_ref.category_nodes(id),
  currency_id uuid references af_ref.currencies(id),
  is_public boolean not null default false,
  status text not null default 'DRAFT',
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table if not exists af_publish.publication_runs (
  id uuid primary key default gen_random_uuid(),
  publication_type text not null,
  as_of_date date not null,
  status text not null default 'PENDING',
  started_at timestamptz,
  completed_at timestamptz,
  item_count integer not null default 0,
  error_message text,
  created_at timestamptz not null default now()
);

create table if not exists af_publish.publication_items (
  id uuid primary key default gen_random_uuid(),
  publication_run_id uuid not null references af_publish.publication_runs(id) on delete cascade,
  published_series_id uuid not null references af_publish.published_series(id),
  economic_date date not null,
  value numeric(32,12),
  return_value numeric(24,16),
  payload jsonb not null default '{}'::jsonb,
  published_at timestamptz,
  created_at timestamptz not null default now(),
  unique(publication_run_id, published_series_id, economic_date)
);

do $$
declare
  r record;
begin
  for r in
    select * from (values
      ('af_ref','currencies'),
      ('af_ref','geographies'),
      ('af_ref','asset_classes'),
      ('af_ref','category_nodes'),
      ('af_ref','market_calendars'),
      ('af_org','organizations'),
      ('af_fund','funds'),
      ('af_fund','subfunds'),
      ('af_fund','share_classes'),
      ('af_source','source_endpoints'),
      ('af_market','official_indices'),
      ('af_market','official_rate_series'),
      ('af_market','instruments'),
      ('af_method','methodologies'),
      ('af_calc','index_definitions'),
      ('af_publish','published_series')
    ) as t(schema_name, table_name)
  loop
    execute format('drop trigger if exists trg_%I_updated_at on %I.%I', r.table_name, r.schema_name, r.table_name);
    execute format('create trigger trg_%I_updated_at before update on %I.%I for each row execute function af_ops.set_updated_at()', r.table_name, r.schema_name, r.table_name);
  end loop;
end $$;

commit;
