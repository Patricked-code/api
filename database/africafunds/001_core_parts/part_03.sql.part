  revision_number integer not null default 1,
  is_current boolean not null default true,
  quality_status text not null default 'PENDING',
  created_at timestamptz not null default now(),
  unique(geography_id, observation_date, revision_number)
);
create unique index if not exists uq_inflation_obs_current on af_market.inflation_observations(geography_id, observation_date) where is_current;

create table if not exists af_market.issuers (
  id uuid primary key default gen_random_uuid(),
  organization_id uuid references af_org.organizations(id),
  name text not null,
  issuer_type text not null,
  geography_id uuid references af_ref.geographies(id),
  created_at timestamptz not null default now()
);

create table if not exists af_market.instruments (
  id uuid primary key default gen_random_uuid(),
  isin text,
  local_code text,
  name text not null,
  instrument_type text not null,
  issuer_id uuid references af_market.issuers(id),
  geography_id uuid references af_ref.geographies(id),
  currency_id uuid not null references af_ref.currencies(id),
  issue_date date,
  maturity_date date,
  coupon_rate numeric(18,10),
  coupon_type text,
  coupon_frequency smallint,
  day_count_convention text,
  nominal_value numeric(28,8),
  outstanding_amount numeric(32,8),
  status text not null default 'ACTIVE',
  source_document_id uuid references af_source.source_documents(id),
  metadata jsonb not null default '{}'::jsonb,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  check (maturity_date is null or issue_date is null or maturity_date >= issue_date)
);
create unique index if not exists uq_instruments_isin on af_market.instruments(isin) where isin is not null;
create index if not exists idx_instruments_geo_maturity on af_market.instruments(geography_id, maturity_date);

create table if not exists af_market.instrument_cashflows (
  id uuid primary key default gen_random_uuid(),
  instrument_id uuid not null references af_market.instruments(id) on delete cascade,
  cashflow_date date not null,
  cashflow_type text not null,
  amount numeric(32,10) not null,
  currency_id uuid not null references af_ref.currencies(id),
  is_projected boolean not null default true,
  source_document_id uuid references af_source.source_documents(id),
  created_at timestamptz not null default now(),
  unique(instrument_id, cashflow_date, cashflow_type)
);

create table if not exists af_market.instrument_market_observations (
  id uuid primary key default gen_random_uuid(),
  instrument_id uuid not null references af_market.instruments(id) on delete cascade,
  observation_date date not null,
  clean_price numeric(24,10),
  dirty_price numeric(24,10),
  accrued_interest numeric(24,10),
  yield_to_maturity numeric(18,10),
  bid_price numeric(24,10),
  ask_price numeric(24,10),
  close_price numeric(24,10),
  reference_price numeric(24,10),
  volume numeric(32,8),
  outstanding_amount numeric(32,8),
  source_observation_id uuid references af_source.source_observations(id),
  quality_status text not null default 'PENDING',
  created_at timestamptz not null default now(),
  unique(instrument_id, observation_date)
);
create index if not exists idx_instrument_market_obs_date on af_market.instrument_market_observations(observation_date);

create table if not exists af_market.auctions (
  id uuid primary key default gen_random_uuid(),
  geography_id uuid not null references af_ref.geographies(id),
  issuer_id uuid references af_market.issuers(id),
  auction_date date not null,
  settlement_date date,
  auction_type text,
  currency_id uuid not null references af_ref.currencies(id),
  source_document_id uuid references af_source.source_documents(id),
  created_at timestamptz not null default now()
);

create table if not exists af_market.auction_results (
  id uuid primary key default gen_random_uuid(),
  auction_id uuid not null references af_market.auctions(id) on delete cascade,
  instrument_id uuid references af_market.instruments(id),
  tenor_label text,
  tenor_days integer,
  maturity_date date,
  amount_offered numeric(32,8),
  amount_tendered numeric(32,8),
  amount_accepted numeric(32,8),
  weighted_average_price numeric(24,10),
  weighted_average_yield numeric(18,10),
  marginal_yield numeric(18,10),
  cut_off_price numeric(24,10),
  bid_cover_ratio numeric(18,10),
  created_at timestamptz not null default now()
);

create table if not exists af_method.methodologies (
  id uuid primary key default gen_random_uuid(),
  code text not null unique,
  name text not null,
  methodology_type text not null,
  description text,
  owner_organization_id uuid references af_org.organizations(id),
  status text not null default 'DRAFT',
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table if not exists af_method.methodology_versions (
  id uuid primary key default gen_random_uuid(),
  methodology_id uuid not null references af_method.methodologies(id) on delete cascade,
  version text not null,
  valid_from date not null,
  valid_to date,
  status text not null default 'ACTIVE',
  parameters jsonb not null default '{}'::jsonb,
  document_url text,
  checksum_sha256 text,
  created_at timestamptz not null default now(),
  unique(methodology_id, version),
  check (valid_to is null or valid_to >= valid_from)
);

create table if not exists af_method.maturity_bucket_rules (
  id uuid primary key default gen_random_uuid(),
  methodology_version_id uuid not null references af_method.methodology_versions(id) on delete cascade,
  geography_id uuid references af_ref.geographies(id),
  bucket_code text not null,
  min_days_exclusive integer,
  max_days_inclusive integer,
  priority smallint not null default 100,
  created_at timestamptz not null default now(),
  unique(methodology_version_id, geography_id, bucket_code),
  check (max_days_inclusive is null or min_days_exclusive is null or max_days_inclusive > min_days_exclusive)
);

create table if not exists af_method.weighting_rules (
  id uuid primary key default gen_random_uuid(),
  methodology_version_id uuid not null references af_method.methodology_versions(id) on delete cascade,
  rule_code text not null,
  weighting_basis text not null,
  scope text not null,
  cap_weight numeric(18,12),
  floor_weight numeric(18,12),
  rebalance_frequency text,
  missing_data_policy text,
  parameters jsonb not null default '{}'::jsonb,
  created_at timestamptz not null default now(),
  unique(methodology_version_id, rule_code)
);

create table if not exists af_ops.pipeline_runs (
  id uuid primary key default gen_random_uuid(),
  pipeline_code text not null,
  run_type text not null,
  requested_from date,
  requested_to date,
  status text not null default 'PENDING',
  started_at timestamptz,
  completed_at timestamptz,
  parameters jsonb not null default '{}'::jsonb,
  metrics jsonb not null default '{}'::jsonb,
  error_message text,
  created_at timestamptz not null default now()
);

create table if not exists af_ops.ingestion_jobs (
  id uuid primary key default gen_random_uuid(),
  pipeline_run_id uuid references af_ops.pipeline_runs(id) on delete cascade,
  source_endpoint_id uuid not null references af_source.source_endpoints(id),
  economic_date date,
  status text not null default 'PENDING',
  attempt_count integer not null default 0,
  discovered_count integer not null default 0,
  downloaded_count integer not null default 0,
  parsed_count integer not null default 0,
  loaded_count integer not null default 0,
  error_count integer not null default 0,
  started_at timestamptz,
  completed_at timestamptz,
  error_message text,
  created_at timestamptz not null default now()
);

create table if not exists af_ops.calculation_runs (
  id uuid primary key default gen_random_uuid(),
  calculation_type text not null,
  methodology_version_id uuid references af_method.methodology_versions(id),
